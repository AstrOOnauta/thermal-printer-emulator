{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may only listen to events and call the app's own commands. No fs, shell, http, opener or dialog: the Rust side does those.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-app-locale",
    "allow-get-receipts",
    "allow-get-receipt",
    "allow-get-listener-status",
    "allow-get-settings",
    "allow-get-lan-address",
    "allow-print-test-receipt",
    "allow-clear-receipts",
    "allow-export-receipt",
    "allow-set-unseen",
    "allow-quit-app",
    "allow-open-repository",
    "allow-get-receipt-commands",
    "allow-set-settings"
  ]
}
