{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thermal Printer Emulator",
  "version": "../package.json",
  "identifier": "io.github.astroonauta.thermalprinteremulator",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Thermal Printer Emulator",
        "width": 680,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5OTg4MjE4MURGRkIzRkMKUldUOHMvOGRHSUtZcWQzekRIRjJ2WGJMOGt0VTBRbWNhYTVzVVJnYW5QTWxiaXNJaWhuaHB6WFAK",
      "endpoints": [
        "https://github.com/AstrOOnauta/thermal-printer-emulator/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Virtual thermal printer for ESC/POS",
    "longDescription": "A thermal printer emulator: a virtual thermal printer that receives ESC/POS print jobs on TCP port 9100, like a network receipt printer, and renders the receipt on screen. Test point-of-sale printing without a physical printer.",
    "publisher": "AstrOOnauta",
    "copyright": "© 2026 Willian Barbosa Lima do Nascimento. MIT License.",
    "homepage": "https://github.com/AstrOOnauta/thermal-printer-emulator",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["English", "Spanish", "PortugueseBR"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "files": {
        "Resources/es.lproj/InfoPlist.strings": "./macos/es.lproj/InfoPlist.strings",
        "Resources/pt-BR.lproj/InfoPlist.strings": "./macos/pt-BR.lproj/InfoPlist.strings"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["libayatana-appindicator-gtk3"]
      }
    }
  }
}
